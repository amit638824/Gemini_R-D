# Gemini (required for Live voice)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_API_VERSION=v1beta
GEMINI_VOICE=Aoede

# Server / deploy
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
PUBLIC_URL=https://apigemini.techwagger.com
CLIENT_ORIGIN=https://apigemini.techwagger.com
TIMER_WARN_BEFORE_SEC=300

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://apigemini.techwagger.com/api/google/callback
GOOGLE_REFRESH_TOKEN=
